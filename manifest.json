{
  "manifest_version": 3,
  "name": "Form Find & Replace",
  "version": "1.1.1",
  "description": "Массовая подмена значений в полях форм на текущей странице по заданным правилам",
  "permissions": ["activeTab", "storage", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Form Find & Replace"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
